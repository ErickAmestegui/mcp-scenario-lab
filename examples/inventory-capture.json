{
  "version": 1,
  "name": "Inventory live-result capture and reuse",
  "endpoint": "http://127.0.0.1:3102/mcp",
  "requiredTools": ["inventory_read", "inventory_take", "inventory_restock"],
  "steps": [
    { "id": "capture-current-stock", "tool": "inventory_read", "capture": { "originalQuantity": "/structuredContent/quantity" } },
    { "id": "take-current-stock", "tool": "inventory_take", "arguments": { "amount": { "$var": "originalQuantity" } }, "assertions": [{ "path": "/structuredContent/quantity", "op": "equals", "value": 0 }] },
    { "id": "restore-original-stock", "tool": "inventory_restock", "arguments": { "amount": { "$var": "originalQuantity" } }, "assertions": [{ "path": "/structuredContent/quantity", "op": "equals", "value": 3 }] }
  ]
}
